module waveform_render (
    input  wire        I_clk,
    input  wire        I_rst,
    input  wire        I_vs,
    input  wire        I_de,
    input  wire [9:0]  I_x,
    input  wire [9:0]  I_y,
    input  wire [23:0] I_rgb,
    output wire        O_vs,
    output wire        O_de,
    output wire [23:0] O_rgb,
    output wire        O_wave_rd_en,
    output wire [9:0]  O_wave_rd_addr,
    input  wire [7:0]  I_wave_rd_data,
    input  wire        I_wave_rd_valid
);

    reg [23:0] rgb_d;
    reg [9:0] x_d;
    reg [9:0] y_d;
    reg vs_d;
    reg de_d;
    reg render_tag_d;

    function [1:0] modulo3;
        input [9:0] value;
        reg [4:0] weighted_sum;
        begin
            weighted_sum = value[0] + value[2] + value[4] + value[6] + value[8] +
                           ({4'd0,value[1]} << 1) + ({4'd0,value[3]} << 1) +
                           ({4'd0,value[5]} << 1) + ({4'd0,value[7]} << 1) +
                           ({4'd0,value[9]} << 1);
            case (weighted_sum)
                5'd0,5'd3,5'd6,5'd9,5'd12,5'd15: modulo3 = 2'd0;
                5'd1,5'd4,5'd7,5'd10,5'd13: modulo3 = 2'd1;
                default: modulo3 = 2'd2;
            endcase
        end
    endfunction

    function [7:0] blend_bar_channel;
        input [7:0] video_channel;
        input [7:0] bar_channel;
        reg [12:0] sum;
        begin
            sum = ({5'd0, bar_channel} << 3) +
                  ({5'd0, bar_channel} << 2) +
                  ({5'd0, video_channel} << 2) + 13'd8;
            blend_bar_channel = sum[11:4];
        end
    endfunction

    wire render_issue = I_de && (I_x < 10'd640) &&
                        (I_y >= 10'd380) && (I_y < 10'd428);

    assign O_wave_rd_en = render_issue;
    assign O_wave_rd_addr = I_x;

    always @(posedge I_clk or posedge I_rst) begin
        if (I_rst) begin
            rgb_d <= 24'd0;
            x_d <= 10'd0;
            y_d <= 10'd0;
            vs_d <= 1'b0;
            de_d <= 1'b0;
            render_tag_d <= 1'b0;
        end else begin
            rgb_d <= I_rgb;
            x_d <= I_x;
            y_d <= I_y;
            vs_d <= I_vs;
            de_d <= I_de;
            render_tag_d <= render_issue;
        end
    end

    wire render_valid = render_tag_d && I_wave_rd_valid;
    wire [13:0] bar_product = ({6'd0, I_wave_rd_data} << 5) +
                              ({6'd0, I_wave_rd_data} << 3) +
                              ({6'd0, I_wave_rd_data} << 2) + 14'd127;
    wire [5:0] mapped_height = bar_product[13:8];
    wire [5:0] bar_height = (I_wave_rd_data <= 8'd2) ? 6'd0 :
                            (mapped_height == 6'd0) ? 6'd1 :
                            (mapped_height > 6'd44) ? 6'd44 : mapped_height;
    wire bar_column = (modulo3(x_d) != 2'd2);
    wire bar_pixel = render_valid && bar_column && (y_d >= 10'd428 - bar_height) && (y_d <= 10'd427);
    wire [23:0] bar_rgb = {
        blend_bar_channel(rgb_d[23:16], 8'hb7),
        blend_bar_channel(rgb_d[15:8], 8'hc5),
        blend_bar_channel(rgb_d[7:0], 8'hc8)
    };

    assign O_vs = vs_d;
    assign O_de = de_d;
    assign O_rgb = bar_pixel ? bar_rgb : rgb_d;

endmodule
